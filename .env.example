# Copy to .env and adjust. Empty or missing values use the defaults shown here.
# Relative paths are resolved against the directory you start novel2img from.

# ---- LLM (Ollama) ----------------------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=BlackHillsInfoSec/llama-3.1-8b-abliterated
# Context window in tokens. Raise it for very long chapters (needs more memory).
OLLAMA_NUM_CTX=8192
# Unload the LLM before rendering, so the image model gets the memory.
# Set to false if you have plenty of (V)RAM; the LLM then stays loaded between chapters.
OLLAMA_UNLOAD=true

# ---- Image model -----------------------------------------------------------
# A single-file Stable Diffusion checkpoint (.safetensors).
SD_MODEL_PATH=models/waiIllustriousSDXL_v170.safetensors
# true for SDXL-based checkpoints (Illustrious, NoobAI, Pony, ...), false for SD 1.5.
SD_IS_SDXL=true
# auto | cuda | mps | cpu
SD_DEVICE=auto
# float16 | bfloat16 | float32 (the CPU always uses float32)
SD_DTYPE=float16

# ---- LoRA (optional) -------------------------------------------------------
LORA_DIR=models/lora
# Comma-separated file:weight pairs, relative to LORA_DIR. The weight defaults to 1.0;
# slider LoRAs also take negative weights. Example:
#   LORA_SPEC=detail_tweaker.safetensors:0.6,my_style.safetensors
LORA_SPEC=

# ---- Generation ------------------------------------------------------------
IMG_WIDTH=832
IMG_HEIGHT=1216
IMG_STEPS=24
IMG_CFG=5.5
# Default maximum number of scenes per chapter (the web UI can override it).
MAX_SCENES=8
# Tags put in front of every prompt, and the negative prompt.
# QUALITY_TAGS=masterpiece, best quality, amazing quality, very aesthetic, highres
# NEGATIVE_PROMPT=bad quality, worst quality, low quality, lowres, jpeg artifacts, blurry, watermark, signature, text, bad anatomy, bad hands, extra fingers, missing fingers

# ---- Files -----------------------------------------------------------------
OUTPUT_DIR=outputs
# Directory with your own LLM prompt templates (see "Customizing the prompts" in the README).
PROMPTS_DIR=
# DEBUG | INFO | WARNING
LOG_LEVEL=INFO
